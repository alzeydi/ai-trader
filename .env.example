# ----- Binance USDT-M Futures -----
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=true

# ----- Anthropic / Claude -----
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-opus-4-7
CLAUDE_MAX_TOKENS=2048

# ----- Telegram notifications -----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# ----- Trading core -----
TRADING_MODE=paper            # paper | live
BASE_CURRENCY=USDT
EQUITY_USD=1000.0
LEVERAGE=3
MARGIN_MODE=ISOLATED          # ISOLATED | CROSSED

# ----- Risk management -----
RISK_PER_TRADE_PCT=0.5        # % equity risked per trade
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_PCT=3.0
MAX_DRAWDOWN_PCT=15.0
ATR_STOP_MULTIPLIER=1.5
ATR_TAKE_MULTIPLIER=3.0

# ----- Safety mode (NoFx pattern) -----
SAFETY_MAX_CONSECUTIVE_LOSSES=3
SAFETY_PAUSE_HOURS=12

# ----- Signal engine -----
TIMEFRAME_TREND=4h
TIMEFRAME_STRUCTURE=1h
TIMEFRAME_EXECUTION=15m
SIGNAL_MIN_CONFIDENCE=0.6

# ----- Persistence -----
DB_PATH=data/trades.db
EQUITY_CSV=data/equity_curve.csv
DECISIONS_CSV=data/ai_decisions.csv

# ----- Runtime -----
LOG_LEVEL=INFO
LOOP_INTERVAL_SEC=60
DRY_RUN=true
