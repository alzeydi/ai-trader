# ----- Binance USDT-M Futures -----
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=true

# ----- Anthropic / Claude -----
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=2048
# Per-(symbol, side, entry_type) cache for veto decisions (seconds).
LLM_VETO_COOLDOWN_SEC=1800

# ----- Telegram notifications -----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# ----- Trading core -----
TRADING_MODE=paper            # paper | live
BASE_CURRENCY=USDT
EQUITY_USD=1000.0
LEVERAGE=3
MARGIN_MODE=ISOLATED          # ISOLATED | CROSSED

# ----- Risk management -----
RISK_PER_TRADE_PCT=0.5        # % equity risked per trade
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_PCT=3.0
MAX_DRAWDOWN_PCT=15.0
ATR_STOP_MULTIPLIER=1.5
ATR_TAKE_MULTIPLIER=3.0

# ----- Type B counter-trend gates -----
# Block Type B when EMA50(1h) has drifted against the trade direction by
# more than B_TREND_BLOCK_PCT over the last B_TREND_LOOKBACK_BARS hours.
B_TREND_BLOCK_PCT=0.05
# Type B HTF gate: block fade if 4h close is > B_HTF_EXTENSION_PCT
# extended from 4h-EMA200 in the trade direction.
B_HTF_EXTENSION_PCT=0.05
B_TREND_LOOKBACK_BARS=12
# Suppress Type B on a symbol for this many hours after a losing B closes.
B_LOSS_COOLDOWN_HOURS=6

# ----- Safety mode (NoFx pattern) -----
SAFETY_MAX_CONSECUTIVE_LOSSES=3
SAFETY_PAUSE_HOURS=12

# ----- Signal engine -----
TIMEFRAME_TREND=4h
TIMEFRAME_STRUCTURE=1h
TIMEFRAME_EXECUTION=15m
SIGNAL_MIN_CONFIDENCE=0.6

# ----- Liquidity filter -----
# Per-cycle screen that drops thin pairs from the universe before signal
# generation. Reduces SL slippage on illiquid books.
MIN_QUOTE_VOLUME_24H_USDT=50000000
MAX_SPREAD_BPS=5
LIQUIDITY_FILTER_CACHE_SEC=300

# ----- Persistence -----
DB_PATH=data/trades.db
EQUITY_CSV=data/equity_curve.csv
DECISIONS_CSV=data/ai_decisions.csv

# ----- Runtime -----
LOG_LEVEL=INFO
LOOP_INTERVAL_SEC=60
DRY_RUN=true
